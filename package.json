{
  "name": "liga-fs-burgos",
  "version": "2.0.0",
  "private": true,
  "description": "Web de la liga FS Infantil Masc. Grupo 2 (Burgos) con scraping horario de deportes.aytoburgos.es",
  "scripts": {
    "scrape": "node scripts/scrape.js",
    "test": "node --test tests/parse.test.js",
    "serve": "node -e \"require('http').createServer((q,r)=>{const f=require('path').join('docs',q.url.split('?')[0].replace(/\\/$/,'/index.html'));require('fs').readFile(f,(e,b)=>{if(e){r.writeHead(404);return r.end()}r.writeHead(200,{'Content-Type':{'.html':'text/html;charset=utf-8','.json':'application/json','.svg':'image/svg+xml','.js':'text/javascript','.webmanifest':'application/manifest+json'}[require('path').extname(f)]||'text/plain'});r.end(b)})}).listen(3000,()=>console.log('http://localhost:3000'))\""
  },
  "engines": { "node": ">=18" }
}
